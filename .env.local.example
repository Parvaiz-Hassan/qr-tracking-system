# Copy this file to .env.local and fill in your own values.
# Get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only, NEVER expose this in client code
# or commit it publicly. Found in Supabase: Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The id of the row you insert into the `companies` table for this demo.
# After running schema.sql, run:
#   insert into companies (name, slug) values ('JP Agro Innovations', 'jp-agro') returning id;
# and paste that id here.
DEMO_COMPANY_ID=paste-the-uuid-here
